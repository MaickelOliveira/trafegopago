# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/private/
/.audit-workspace

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados persistentes (não subir pro git - montar como volume no servidor)
/data/
/public/uploads/

# sessão whatsapp (credenciais sensíveis)
wa-session/

# claude code settings
.claude/

/.trafegopago-validation

# Local rendered review evidence must remain private
/docs/audit/visual/
/docs/audit/evidence.json
