# PostgreSQL on a private network. No file-storage fallback in production.
DATABASE_URL=postgresql://APPLICATION_USER:REPLACE_ME@DATABASE_HOST:5432/trafegopago
JWT_SECRET=REPLACE_WITH_EXISTING_PRODUCTION_SESSION_SECRET
APP_BASE_URL=https://YOUR_EXISTING_PLATFORM_HOST
TP_BACKGROUND_JOBS_ENABLED=true
ENABLE_DIAGNOSTIC_ROUTES=false
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# Daily encrypted backup at 03:00 America/Sao_Paulo. Keep the encryption key
# separately: without it, the contents of the backup cannot be recovered.
BACKUP_HOUR=03:00
BACKUP_DRIVE_FOLDER_ID=
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
BACKUP_GOOGLE_CLIENT_ID=
BACKUP_GOOGLE_CLIENT_SECRET=
BACKUP_GOOGLE_REFRESH_TOKEN=
BACKUP_DIR=/app/private/backups
# Initial import: public RSA key only; the matching PRIVATE key stays offline.
BACKUP_SNAPSHOT_PUBLIC_KEY=
LEGACY_DATA_DIR=/app/data
LEGACY_BACKUP_DIR=/app/data/audit-backups
LEGACY_IMPORT_OLD_WRITER_STOPPED=false
# Set an alias only after the owner confirms both IDs represent the same client.
LEGACY_CLIENT_ALIAS_FROM=
LEGACY_CLIENT_ALIAS_TO=

# Preserve the existing integration settings when changing the application.
# Most existing integration credentials are imported from config.json.
META_APP_SECRET=
